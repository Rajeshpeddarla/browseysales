{
  "manifest_version": 3,
  "name": "Browsey Sales Intelligence",
  "version": "2.0.0",
  "description": "AI-powered sales research — extracts company intelligence directly from your browser.",
  "permissions": [
    "storage",
    "activeTab",
    "scripting",
    "tabs",
    "sidePanel"
  ],
  "host_permissions": ["<all_urls>"],
  "action": {
    "default_title": "Browsey Research",
    "default_icon": {
      "128": "icons/icon-128.png"
    }
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "exclude_matches": ["*://localhost/*", "*://127.0.0.1/*"],
      "js": ["content/extractor.js"],
      "run_at": "document_idle"
    }
  ],
  "side_panel": {
    "default_path": "ui/sidepanel.html"
  },
  "icons": {
    "128": "icons/icon-128.png"
  },
  "chrome_url_overrides": {
    "newtab": "ui/newtab.html"
  }
}
